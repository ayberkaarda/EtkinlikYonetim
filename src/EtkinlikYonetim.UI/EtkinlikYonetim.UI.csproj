<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>EtkinlikYonetim.UI</RootNamespace>
    <AssemblyName>EtkinlikYonetim</AssemblyName>
    <Product>Etkinlik Yönetim</Product>
    <NeutralLanguage>tr-TR</NeutralLanguage>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <UserSecretsId>etkinlik-yonetim-ui</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Include="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="appsettings.json" Condition="Exists('appsettings.json')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Original artwork: the logo and icon are rasterized from assets/logo.svg by tools/Screenshots (icons command). -->
    <EmbeddedResource Include="..\..\assets\logo-256.png" Link="Assets\logo-256.png" LogicalName="EtkinlikYonetim.UI.Assets.logo-256.png" />
    <EmbeddedResource Include="..\..\assets\app.ico" Link="Assets\app.ico" LogicalName="EtkinlikYonetim.UI.Assets.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EtkinlikYonetim.UI.Tests" />
    <InternalsVisibleTo Include="EtkinlikYonetim.Screenshots" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EtkinlikYonetim.Business\EtkinlikYonetim.Business.csproj" />
    <ProjectReference Include="..\EtkinlikYonetim.Data\EtkinlikYonetim.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <!-- QR code of the ticket: MIT licensed, managed encoder; its PNG renderer needs no GDI+. Pinned to exactly one version. -->
    <PackageReference Include="QRCoder" Version="[1.6.0]" />
    <PackageReference Include="ReaLTaiizor" Version="3.8.1.2" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
